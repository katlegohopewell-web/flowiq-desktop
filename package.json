{
  "name": "flowiq",
  "version": "2.0.0",
  "description": "FlowIQ — Stormwater Runoff Calculator (SANRAL Drainage Manual methods)",
  "main": "main.js",
  "author": "Your Company Name",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:win-portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourcompany.flowiq",
    "productName": "FlowIQ",
    "icon": "icon.ico",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
